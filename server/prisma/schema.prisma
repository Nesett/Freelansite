generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  ON_HOLD
}

enum MilestoneStatus {
  NOT_STARTED
  CURRENTLY_WORKED_ON
  AWAITING_APPROVAL
  APPROVED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  businessName String?  @map("business_name")
  createdAt    DateTime @default(now()) @map("created_at")
  address      String?

  clients  Client[]
  projects Project[]

  @@map("admins")
}

model Client {
  id                 String    @id @default(uuid())
  adminId            String    @map("admin_id")
  name               String?
  email              String    @unique
  phone              String?
  companyName        String?
  password           String?
  address            String?
  createdAt          DateTime  @default(now()) @map("created_at")
  lastActive         DateTime  @default(now()) @map("last_active")
  isActive           Boolean   @default(true) @map("is_active")
  inviteToken        String?   @unique
  inviteTokenExpires DateTime?

  admin    Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  projects Project[]

  @@map("clients")
}

model Project {
  id          String        @id @default(uuid())
  clientId    String        @map("client_id")
  adminId     String        @map("admin_id")
  title       String
  description String?
  budget      Int?
  status      ProjectStatus @default(NOT_STARTED)
  notes       String?
  deletedByAdmin  Boolean       @default(false) @map("deleted_by_admin")
	deletedByClient Boolean       @default(false) @map("deleted_by_client")
  createdAt   DateTime      @default(now()) @map("created_at")

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  admin      Admin       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  invoices   Invoice[]

  @@map("projects")
}

model Milestone {
  id               String          @id @default(uuid())
  projectId        String          @map("project_id")
  title            String
  description      String?
  budget           Float?
  status           MilestoneStatus @default(NOT_STARTED)
  deadline         DateTime?
  orderIndex       Int             @map("order_index")
  deletedByAdmin  Boolean       @default(false) @map("deleted_by_admin")
	deletedByClient Boolean       @default(false) @map("deleted_by_client")
  generatedInvoice Boolean         @default(false) @map("generated_invoice")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model Invoice {
  id            String        @id @default(uuid())
  projectId     String        @map("project_id")
  status        InvoiceStatus @default(UNPAID)
  deadline      DateTime
  issueDate     DateTime      @default(now())
  total         Float
  adminName     String
  adminAddress  String
  clientName    String
  clientAddress String
  deletedByAdmin  Boolean       @default(false) @map("deleted_by_admin")
	deletedByClient Boolean       @default(false) @map("deleted_by_client")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  title       String
  description String?
  amount      Float
  quantity    Float   @default(1)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoiceItems")
}
